---
import LibraryRow from './LibraryCard.astro';
import type { Library } from '../data/libraries';

interface Props {
  category: string;
  cacheMeta: { id: string, timestamp: number, oldestPart?: string }[];
}

const { category, libraries, cacheMeta } = Astro.props;

const sortedLibraries = libraries.sort((a, b) => {
  if (a.status === 'preferred' && b.status !== 'preferred') return -1;
  if (a.status !== 'preferred' && b.status === 'preferred') return 1;
  return 0;
});
---

<section id={category.toLowerCase().replace('/', '-')}>
  <h2>{category}</h2>
  
  <div class="list" data-category={category}>
    {sortedLibraries.map(lib => {
      const meta = cacheMeta.find(m => m.id === lib.id);
      return <LibraryRow lib={lib} cacheTimestamp={meta?.timestamp || 0} oldestPart={meta?.oldestPart} />
    })}
  </div>
</section>


