---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import RegistryControls from '../components/RegistryControls.astro';
import RegistrySection from '../components/RegistrySection.astro';
import { libraries } from '../data/libraries';
import { getCacheMeta } from '../utils/cache';
import { formatDistanceToNow } from 'date-fns';

const categories = [...new Set(libraries.map(lib => lib.category))];
const cacheMeta = getCacheMeta();

// Build Time Evaluated ONCE during Vercel Deployment
const lastDeployText = formatDistanceToNow(new Date(), { addSuffix: true });
---

<Layout title="Lib Registry">
  <Navbar />
  <RegistryControls categories={categories} />

	<div class="container">
    <main id="registry-main">
      {categories.map(category => (
        <RegistrySection 
          category={category} 
          libraries={libraries.filter(l => l.category === category)}
          cacheMeta={cacheMeta}
        />
      ))}
    </main>

    <footer class="main-footer">
      <div class="system-status">
        <div class="status-indicator"></div>
        <span class="status-text">Algorithm Status: <span>Initializing...</span></span>
      </div>
      <div class="system-details">
        <span>Nodes Synced: <span id="synced-count">0/0</span></span>
        <span class="separator">|</span>
        <span>Oldest Queue Node: <span id="oldest-node">Scanning</span></span>
      </div>
    </footer>

    <div class="site-footer">
      <span>Developed by <a href="https://github.com/fastfingertips" target="_blank">FastFingertips</a></span>
      <span class="separator">•</span>
      <a href="https://github.com/fastfingertips/python-packages" target="_blank">Open Source on GitHub</a>
      <span class="separator">•</span>
      <span class="deploy-stamp" title="This signifies the last time the entire Server/Edge Network was built from GitHub source.">Deployed {lastDeployText}</span>
    </div>
	</div>
</Layout>

<style>
  .main-footer {
    margin-top: 4rem; 
    padding: 1.5rem; 
    font-family: var(--font-mono); 
    font-size: 0.6rem; 
    color: var(--text-dim); 
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.02);
  }
  
  @media (prefers-color-scheme: dark) {
    .main-footer { background: rgba(255, 255, 255, 0.02); }
  }

  .site-footer {
    margin-top: 1rem;
    padding-bottom: 4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    align-items: center;
    opacity: 0.5;
  }

  .site-footer a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px dotted var(--text-dim);
  }

  .site-footer a:hover {
    opacity: 0.7;
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #eab308; /* Init Color */
    animation: pulse 2s infinite;
  }

  .system-details {
    display: flex;
    gap: 0.8rem;
    opacity: 0.7;
  }

  .separator {
    opacity: 0.3;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
  }
</style>

<script>
  import { initSystemMonitor } from '../client/systemMonitor';
  document.addEventListener('astro:page-load', initSystemMonitor);
  document.addEventListener('DOMContentLoaded', initSystemMonitor);
</script>
